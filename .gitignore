# Runtime logs, scratch state and root-local sandboxes.
logs/
*.log
/debug/
/debug_sessions/
# Most root cache contents are local. Keep the two existing architecture records
# visible without opening the rest of this tree to accidental additions.
/cache/**
!/cache/artifacts/
!/cache/artifacts/real/
!/cache/artifacts/real/idea9/
!/cache/artifacts/real/idea9/20260818/
!/cache/artifacts/real/idea9/20260818/idea9_architecture_contract.json
!/cache/artifacts/real/idea9/20260818/idea9_architecture_contract.png
/realtime/
.gstack/
.webassets-cache/
.scrapy/
instance/
local_settings.py
celerybeat-schedule
celerybeat.pid
profile_default/
ipython_config.py
.ipynb_checkpoints/

# Runtime databases, scoped to data/output locations. Test fixtures stay visible.
/*.db
/*.db-*
/*.sqlite
/*.sqlite3
/*.sqlite*-*
/data/**/*.db
/data/**/*.db-*
/data/**/*.sqlite
/data/**/*.sqlite3
/data/**/*.sqlite*-*
/outputs/**/*.db
/outputs/**/*.db-*
/outputs/**/*.sqlite*
/experiments/**/*.db
/experiments/**/*.db-*
/experiments/**/*.sqlite*

# Checkpoints written by experiments; small reviewed tests/fixtures are outside
# these paths. Do not ignore every .pkl/.npz: some are intentional study evidence.
/experiments/**/*.pt
/experiments/**/*.pth
/experiments/**/*.ckpt
/experiments/**/*.safetensors
/outputs/**/*.pt
/outputs/**/*.pth
/outputs/**/*.ckpt
/outputs/**/*.safetensors

# Media collections: permit traversal only so the selected metadata below can
# be added. Other contents, including poses and bulk predictions, stay ignored.
/data/videos*/**
!/data/videos*/**/
/data/youtube*/**
!/data/youtube*/**/
/data/models/**
!/data/models/**/
/**/data-videos*/**
!/**/data-videos*/**/
/**/video-data*/**
!/**/video-data*/**/
!/data/videos*/**/README.[mM][dD]
!/data/videos*/**/[Ll][Ii][Cc][Ee][Nn][Ss][Ee]*
!/data/videos*/**/manifest.json
!/data/videos*/**/checksums.sha256
!/data/youtube*/**/README.[mM][dD]
!/data/youtube*/**/[Ll][Ii][Cc][Ee][Nn][Ss][Ee]*
!/data/youtube*/**/manifest.json
!/data/youtube*/**/checksums.sha256
!/data/models/**/README.[mM][dD]
!/data/models/**/[Ll][Ii][Cc][Ee][Nn][Ss][Ee]*
!/data/models/**/manifest.json
!/data/models/**/checksums.sha256
!/**/data-videos*/**/README.[mM][dD]
!/**/data-videos*/**/manifest.json
!/**/video-data*/**/README.[mM][dD]
!/**/video-data*/**/manifest.json

# Downloaded media can also appear outside standard dataset folders.
# Deliberate, small fixtures have an explicit exception; review size and rights.
*.mp4
*.mp3
*.avi
!/tests/fixtures/**/*.mp4
!/tests/fixtures/**/*.mp3
!/tests/fixtures/**/*.avi

# Existing local data/training stores. Dataset annotations under data/gavd and
