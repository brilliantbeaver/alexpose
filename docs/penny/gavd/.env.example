# Skeleton-JEPA GAVD (full-dataset) tutorials environment configuration.
#
# Copy this file to ".env" in this same folder and edit the paths to match
# your machine. The notebooks read this file automatically (via python-dotenv)
# so the REAL data path can find your local alexpose checkout and the GAVD
# data without you editing any code. In SMOKE_TEST mode none of these are
# needed, so you can leave the file untouched and everything still runs.

# Absolute path to your local alexpose repository checkout. The notebooks add
# this to sys.path so they can import the ambient package (GAVDDataLoader,
# SequenceKeypointExtractor, YouTubeHandler). Leave blank to use the inline
# fallback (raw yt-dlp + OpenCV + MediaPipe) instead.
ALEXPOSE_REPO=/Users/pmui/dev/alexpose

# Folder that holds the per-condition GAVD sequence CSV files, organized as
# GAVD_DATA_DIR/<condition>/<seq>.csv (for example .../parkinsons/clj....csv).
# This whole tree of 374 CSVs across 11 conditions is what the full-dataset
# series scans, downloads, and extracts.
GAVD_DATA_DIR=/Users/pmui/dev/alexpose/data/gavd

# Folder where downloaded YouTube videos are cached as <video_id>.mp4. The
# bulk-download notebook fills this folder once, and every later notebook
# reuses the cached files. Expect this to grow large on a full real run.
YOUTUBE_CACHE_DIR=/Users/pmui/dev/alexpose/data/youtube

# Folder where this series caches its own intermediate artifacts (the CSV
# manifest, the per-condition skeleton .npz files, the windowed corpus, and
# the trained encoder). Defaults to a "cache" folder next to the notebooks if
# left blank. Keeping it separate from alexpose means you can delete it freely.
GAVD_CACHE_DIR=

# The demo GAVD clip used whenever a single worked example is helpful. This
# clip is a parkinsons walking sequence, is already cached in most setups, and
# is small enough to download quickly.
DEMO_VIDEO_ID=B5hrxKe2nP8
