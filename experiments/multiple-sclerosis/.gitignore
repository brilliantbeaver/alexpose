# Local environment (created by `uv sync` in this folder)
.venv/
.python-version

# Transient training/run outputs (regenerated by the notebooks).
# The pose keypoints cache under artifacts/keypoints/ is intentionally KEPT so
# notebooks 02-06 open instantly, so it is NOT ignored here.
artifacts/*.pt
artifacts/*.gif
artifacts/embeddings_*.npz
artifacts/capstone_results.json
artifacts/split_spec.json

# PDF build scratch
docs/_pdfbuild/

# Notebook checkpoints and caches
.ipynb_checkpoints/
__pycache__/
.coverage
