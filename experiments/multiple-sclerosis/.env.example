# Sample environment for the S-JEPA gait tutorials
# ------------------------------------------------------------------------------
# Copy this file to the REPOSITORY ROOT as `.env` (the notebooks load the root
# .env), or keep a copy here and load it explicitly. The defaults below are safe
# to use as-is; adjust only if you know you need to.
#
#   cp experiments/multiple-sclerosis/.env.example .env      # from repo root
#
# Only the SJEPA_* variables are specific to this experiment. The others are
# inherited from the wider alexpose project and rarely need changing here.

# --- Model size profile ---------------------------------------------------
# "laptop": tiny model, trains in minutes on CPU, Apple MPS, or a Colab T4.
# "gpu":    larger model, closer to the paper, needs a real GPU.
SJEPA_PROFILE=laptop

# Set to 1 to shrink whichever profile you picked to a near-instant test size.
# Handy for checking that every notebook runs end to end. Set back to 0 for real
# training.
SJEPA_SMOKE=0

# --- Pose extraction ------------------------------------------------------
# Frames per second to sample from each video before running pose. 15 is a good
# balance of temporal detail and speed for gait.
SJEPA_TARGET_FPS=15

# --- Paths (inherited from alexpose; defaults work out of the box) --------
ALEXPOSE_DATA_DIR=data
ALEXPOSE_CONFIG_DIR=config
ALEXPOSE_LOGS_DIR=logs

# --- Pose estimator settings (inherited) ----------------------------------
DEFAULT_POSE_ESTIMATOR=mediapipe
POSE_CONFIDENCE_THRESHOLD=0.5

# --- Reproducibility ------------------------------------------------------
# The random seed used for model init, splits, and the Random Forest.
SJEPA_SEED=42
