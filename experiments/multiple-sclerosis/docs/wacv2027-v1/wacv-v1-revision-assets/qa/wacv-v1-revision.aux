\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces From gait clips to held-out label prediction. All clips from one source recording remain in the same training, validation or test partition before windows are constructed. Each encoder is fitted on 24 source videos. The frozen-feature classifier uses collection labels, while the encoder's feature-learning objective does not. Validation selects between the two executed training stages. Baseline methods use the same source partitions.\relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{3}{From gait clips to held-out label prediction. All clips from one source recording remain in the same training, validation or test partition before windows are constructed. Each encoder is fitted on 24 source videos. The frozen-feature classifier uses collection labels, while the encoder's feature-learning objective does not. Validation selects between the two executed training stages. Baseline methods use the same source partitions.\relax }{figure.caption.1}{}}
\newlabel{fig:pipeline@cref}{{[figure][1][]1}{[1][2][]3}}
