# Local cache of intermediate artifacts (manifest, skeletons, corpus, encoder).
# Regenerated by running the notebooks; never committed.
cache/
gavd_cache/

# The virtual environment and Python caches.
.venv/
__pycache__/
*.pyc

# Downloaded videos, if a run points the cache here.
*.mp4

# Jupyter checkpoints.
.ipynb_checkpoints/

# Vendored reveal.js is a committed dependency, not a Python build artifact. The
# repo-root ".gitignore" line 8 "dist/" rule (a Python packaging rule) would otherwise
# drop reveal.js's core files (reveal.js, reveal.css, reset.css, theme/white.css) and
# the decks would not render offline for anyone who clones. Re-include the vendored dir.
!slides/reveal/dist/
!slides/reveal/dist/**
