# Copy these names into the repository-root .env only after the external
# dataset and its authorization records actually exist. Absolute paths are
# clearest. Relative paths are resolved from the .env file's directory.

LATERALITY_EXTERNAL_MANIFEST=/absolute/path/to/external-manifest.csv
LATERALITY_EXTERNAL_GOVERNANCE=/absolute/path/to/external-governance.json
LATERALITY_EXTERNAL_POSE_ROOT=/absolute/path/to/external-pose-files
