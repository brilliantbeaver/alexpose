ALEXPOSE_ROOT=/Users/alexmui/dev/alexpose
GAVD_CACHE_DIR=cache
GAVD_ARTIFACT_DIR=work/artifacts
GAVD_MODE=real

# Opt in to the staged real-data workflow only when ready.
# GAVD_DOWNLOAD=1
# Retryable YouTube failures use embedded, TV, HLS, then permissive fallback.
# GAVD_RETRY_COOLDOWN_SECONDS=5
# Keep 0 for research runs with explicit attrition; use 1 for strict CI/release gates.
# GAVD_STRICT_DOWNLOADS=0
# GAVD_EXTRACT_POSES=1
# GAVD_EXTRACT_CONDITIONS=normal
# GAVD_MAX_SEQUENCES=1
# Validate and atomically add v3 provenance to compatible legacy pose arrays.
# GAVD_MIGRATE_LEGACY_POSES=1
# Retry only labelled transient decoder/MediaPipe errors (1 = two attempts total).
# GAVD_POSE_RETRIES=1
# GAVD_POSE_RETRY_BACKOFF_SECONDS=1
# Keep 0 to finish the audit with explicit attrition; use 1 for strict CI gates.
# GAVD_STRICT_POSE_EXTRACTION=0
# Debug-only: stop immediately after recording the first failed sequence.
# GAVD_FAIL_FAST=0

# Notebook 04: normal-only Stage 0, then four cumulative continuation stages.
# SJEPA_RUN_PROFILE=recommended
# SJEPA_NORMAL_EPOCHS=300
# SJEPA_FINETUNE_EPOCHS=75
# SJEPA_SAMPLES_PER_CONDITION=4
# SJEPA_VICREG_WEIGHT=0.05
# SJEPA_GROUP_WEIGHT=0.25
# SJEPA_GROUP_MARGIN=1.0
# Use 1 to reproduce the completed 159-sequence run in notebooks 04-06.
# SJEPA_INCLUDE_AUGMENTED_NORMAL=1
# Optional downstream overrides (normally leave unset).
# SJEPA_INSPECT_CHECKPOINT=sjepa_curriculum_final_augmented.pt
# SJEPA_CLASSIFIER_CHECKPOINT=sjepa_curriculum_final_augmented.pt
