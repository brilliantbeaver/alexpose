# Skeleton-JEPA GAVD iteration 2 (gavd2) environment configuration.
#
# Copy this file to ".env" in this same folder and edit the paths to match
# your machine. The notebooks read this file automatically (via python-dotenv)
# so the REAL data path can find your local alexpose checkout and the GAVD
# data without you editing any code. In SMOKE_TEST mode none of these are
# needed, so you can leave the file untouched and everything still runs.
#
# gavd2 is fully self-contained: it keeps its OWN derived-artifact cache
# (leave GAVD_CACHE_DIR blank so it defaults to gavd2/cache) and never reads
# the iteration-1 gavd/ cache. It shares only the external YOUTUBE_CACHE_DIR
# so already-downloaded videos are reused rather than fetched again.
# NOTE: python-dotenv searches UPWARD for the nearest .env, so gavd2 ships its
# own committed .env; without it the search would find the repo-root .env,
# which has none of these paths, and REAL nb00 would fail to find the data.

# Absolute path to your local alexpose repository checkout. The notebooks add
# this to sys.path so they can import the ambient package (GAVDDataLoader,
# SequenceKeypointExtractor, YouTubeHandler). Leave blank to use the inline
# fallback (raw yt-dlp + OpenCV + MediaPipe) instead.
ALEXPOSE_REPO=/Users/pmui/dev/alexpose

# Folder that holds the per-condition GAVD sequence CSV files, organized as
# GAVD_DATA_DIR/<condition>/<seq>.csv (for example .../parkinsons/clj....csv).
# This whole tree of 374 CSVs across 11 conditions is what the full-dataset
# series scans, downloads, and extracts.
GAVD_DATA_DIR=/Users/pmui/dev/alexpose/data/gavd

# Folder where downloaded YouTube videos are cached as <video_id>.mp4. The
# bulk-download notebook fills this folder once, and every later notebook
# reuses the cached files. Expect this to grow large on a full real run.
YOUTUBE_CACHE_DIR=/Users/pmui/dev/alexpose/data/youtube

# Folder where this series caches its own intermediate artifacts (the CSV
# manifest, the per-condition skeleton .npz files, the windowed corpus, and
# the trained encoder). Leave BLANK so it defaults to a "cache" folder next to
# these notebooks (gavd2/cache), which keeps iteration 2 independent of the
# iteration-1 gavd/ cache. Do not point this at gavd/gavd_cache.
GAVD_CACHE_DIR=

# The curated exp5 labelled tree (five condition folders, 68 sequences total).
# gavd2 locks its labelled probe set to exactly these 68 sequence ids so the
# frozen-probe evaluation is a controlled comparison against the exp5 Random
# Forest baseline. Used by notebook 00's tier-2 id resolver.
EXP4_DATA_DIR=/Users/pmui/dev/alexpose/experiments/exp4/data

# The exp5 82-feature pickle. Notebook 00's tier-1 resolver reads the exact 68
# sequence ids and, crucially, their ORDER from here so it can reproduce exp5's
# exact seed-42 train/test split for a like-for-like accuracy point. In the
# gavd2 notebook venv this unpickle fails (the pickled objects need the ambient
# package), so nb00 falls through to the tier-2 folder glob; that is expected.
EXP5_FEATURES_PKL=/Users/pmui/dev/alexpose/experiments/exp5/features/all82_features.pkl

# The demo GAVD clip used whenever a single worked example is helpful. This
# clip is a parkinsons walking sequence, is already cached in most setups, and
# is small enough to download quickly.
DEMO_VIDEO_ID=B5hrxKe2nP8
