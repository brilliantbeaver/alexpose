# Paths default to this checkout's data/gavd, work/youtube, work/cache, and
# work/artifacts directories. Set these only when deliberately mounting data elsewhere.
# ALEXPOSE_ROOT=/absolute/path/to/alexpose
# GAVD_DATA_GAVD_DIR=/absolute/path/to/alexpose/data/gavd
# GAVD_YOUTUBE_DIR=work/youtube
# GAVD_CACHE_DIR=work/cache
GAVD_ARTIFACT_DIR=work/artifacts
GAVD_MODE=real

# Opt in to the staged real-data workflow only when ready.
# GAVD_DOWNLOAD=1
# GAVD_EXTRACT_POSES=1
# GAVD_EXTRACT_CONDITIONS=normal
# GAVD_MAX_SEQUENCES=1

# Notebook 04: normal-only Stage 0, then four cumulative continuation stages.
# SJEPA_RUN_PROFILE=recommended
# SJEPA_NORMAL_EPOCHS=300
# SJEPA_FINETUNE_EPOCHS=75
# SJEPA_SAMPLES_PER_CONDITION=4
# SJEPA_VICREG_WEIGHT=0.05
# SJEPA_GROUP_WEIGHT=0.25
# SJEPA_GROUP_MARGIN=1.0
# Use 1 to reproduce the completed 159-sequence run in notebooks 04-06.
# SJEPA_INCLUDE_AUGMENTED_NORMAL=1
# Optional downstream overrides (normally leave unset).
# SJEPA_INSPECT_CHECKPOINT=sjepa_curriculum_final_augmented.pt
# SJEPA_CLASSIFIER_CHECKPOINT=sjepa_curriculum_final_augmented.pt
