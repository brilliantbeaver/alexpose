# Source after the original study profile, or let submit.sh load this file.
# Existing ST_* settings remain unchanged. The checker verifies the interpreter.
export STV2_ROOT="${STV2_ROOT:-${GAVD6_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}}"
export STV2_PYTHON="${STV2_PYTHON:-${ST_PYTHON:-/hai/scratch/$USER/envs/synthetic-training-cu124/bin/python}}"
export STV2_WORK="${STV2_WORK:-$STV2_ROOT/outputs/synthetic-training-v2/source-smoke-01}"
export PYTHONPATH="$STV2_ROOT/src"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export PYTHONNOUSERSITE=1 PYOPENGL_PLATFORM=egl CUBLAS_WORKSPACE_CONFIG=:4096:8
# Phase configurations are selected by the launcher, never by a template default.
