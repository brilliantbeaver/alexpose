.venv/
__pycache__/
.ipynb_checkpoints/
.DS_Store
cache/matplotlib/
cache/models/
cache/artifacts/
data-augmented/

# Local source sequences and all derived experimental outputs. These artifacts
# remain available locally for reproduction but are not published in Git.
data/
cache/artifacts/real/

# Executed notebook copies are run artifacts, not source notebooks.
artifacts/notebook_runs/
notebook_runs/

# Local experiment outputs are retained for reproducibility but never committed.
# Keep this boundary path-scoped: CSV/JSON/NPZ and image files are also source
# manifests, protocol fixtures, and documentation assets elsewhere in this
# repository, so a repository-wide extension ignore would hide real work.
outputs/
output/
work/
tmp/

# Generated AMASS/GAVD inventories and benchmark manifests are local data
# artifacts. Their schema is defined by the checked-in builder scripts.
manifests/amass/
manifests/gavd/
manifests/archive/
